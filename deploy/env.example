# ============================================================
# Environment variables required by the PKPM API server
#
# RECOMMENDED: set these via cPanel → Node.js Selector →
#   Environment Variables (no file needed on disk).
#
# ALTERNATIVE: copy this file to .env in the app root directory.
#   The app loads .env automatically (via dotenv) if present.
#   Variables already set in the Selector take priority over .env.
# ============================================================

# MySQL connection string (already points to Jagoan Hosting DB)
DATABASE_URL=mysql://USERNAME:PASSWORD@101.50.1.94:3306/DB_NAME

# Secret key for session cookies – use a long random string
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Admin login credentials (username:password)
ADMIN_CREDENTIALS=admin:REPLACE_WITH_SECURE_PASSWORD

# Node environment – must be "production"
NODE_ENV=production
